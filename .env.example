# ==============================================================================
# Entre Páginas - Variáveis de Ambiente & Configurações de Deploy
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BANCO DE DADOS (PostgreSQL Local ou Supabase Free Tier)
# ------------------------------------------------------------------------------
# ATENÇÃO: NÃO UTILIZE A DATABASE_URL DE PRODUÇÃO (Supabase) NO AMBIENTE DE DESENVOLVIMENTO.

# 🖥️ Para desenvolvimento local (Mantenha este no seu .env local):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/entre_paginas?schema=public"

# ☁️ Para produção no Supabase (Mantenha estes configurados APENAS no painel da Vercel):
# URL com Transaction Pooler (porta 6543) - Usada para queries do app
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# URL de conexão direta (porta 5432) - Usada APENAS para Migrations
# DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 2. SEGURANÇA & SESSÃO
# ------------------------------------------------------------------------------
# Chave secreta de alta entropia para assinatura de sessões e tokens (mínimo 32 caracteres)
AUTH_SECRET="sua-chave-secreta-de-alta-entropia-gerada-com-openssl-rand-hex-32"

# URL pública da aplicação
NEXT_PUBLIC_APP_URL="http://localhost:3001"
# Em produção na Vercel:
# NEXT_PUBLIC_APP_URL="https://entre-paginas.vercel.app"

# ------------------------------------------------------------------------------
# 3. CHAVES DE API OPCIONAIS (FONTES EXTERNAS)
# ------------------------------------------------------------------------------
# Europeana Cultural Heritage API (Opcional - https://pro.europeana.eu/page/get-api)
EUROPEANA_API_KEY=""

# Google Books API Key (Opcional - aumenta a cota por minuto)
GOOGLE_BOOKS_API_KEY=""
